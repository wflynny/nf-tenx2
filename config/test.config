params {
    config_profile_description = 'Stub test profile'
    config_profile_contact     = 'nf-tenx2 developers'

    max_memory = 2.GB
    max_cpus   = 2
    max_time   = 1.h

    // Use test fixtures
    pubdir = "${launchDir}/test/results"
}

process {
    cpus   = 1
    memory = 512.MB
    time   = 10.min
    executor = 'local'
}

// No singularity in test mode — stubs don't need containers
singularity.enabled = false
docker.enabled      = false
