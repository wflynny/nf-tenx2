profiles {
    elion2  { includeConfig "config/elion2.config" }
    sumner2 { includeConfig "config/sumner2.config" }
    testing { includeConfig "config/test.config" }
}

apptainer.registry    = "quay.io"
docker.registry       = "quay.io"
podman.registry       = "quay.io"
singularity.registry  = "quay.io"
charliecloud.registry = "quay.io"

process.shell = [
    "bash",
    "-C",
    "-e",
    "-u",
    "-o",
    "pipefail"
]

params {
    // --- Input ---
    inputJsonFiles = null   // --input-json-files file1.json file2.json ...
    inputDir       = null   // --input-dir path/to/json/files/
    pipeline       = null   // gex | atac | multiome | visium | xenium

    // --- Output ---
    pubdir   = "${launchDir}/results"
    tracedir = "${params.pubdir}/pipeline_info"

    // --- Pipeline metadata ---
    version = "0.1.0"

    // --- Defaults for optional record fields ---
    defaultIncludeIntrons = true
    defaultCreateBam      = false
}

// --- Centralized publishDir + default resources ---
// Profiles (elion2, sumner2) override these with label-based scaling.
// These defaults ensure the pipeline runs even without a profile.
process {
    cpus   = 1
    memory = 6.GB
    time   = 4.h

    withLabel: 'process_single' {
        cpus   = 1
        memory = 6.GB
        time   = 4.h
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 12.GB
        time   = 4.h
    }
    withLabel: 'process_medium' {
        cpus   = 6
        memory = 36.GB
        time   = 8.h
    }
    withLabel: 'process_high' {
        cpus   = 12
        memory = 72.GB
        time   = 16.h
    }
    withLabel: 'process_long' {
        time   = 20.h
    }
    withLabel: 'process_high_memory' {
        memory = 200.GB
    }

    withName: 'CELLRANGER_COUNT|CELLRANGER_MULTI|CELLRANGER_ATAC_COUNT|CELLRANGER_ARC_COUNT|SPACERANGER_COUNT' {
        publishDir = [[path: { "${params.pubdir}/${record.pipeline.dataset_id}" }, mode: 'copy']]
    }
    withName: 'XENIUMRANGER_RESEGMENT|XENIUMRANGER_RELABEL' {
        publishDir = [[path: { "${params.pubdir}/${record.pipeline.dataset_id}" }, mode: 'copy']]
    }
    withName: 'GENERATE_METADATA' {
        publishDir = [[path: { "${params.pubdir}/${record.pipeline.dataset_id}" }, mode: 'copy']]
    }
    withName: 'MULTIQC' {
        publishDir = [[path: { "${params.pubdir}/multiqc" }, mode: 'copy']]
    }
    // exec: processes can't run on batch executors
    withName: 'CAPTURE_WORKFLOW' {
        executor = 'local'
    }
}

manifest {
    name          = "nf-tenx2"
    contributors  = [
        [
            name: "Bill Flynn",
            affiliation: "The Jackson Laboratory",
            email: "bill.flynn@jax.org",
            github: "",
            contribution: ["author"],
            orcid: ""
        ],
        [
            name: "Ahmed Said",
            affiliation: "The Jackson Laboratory",
            email: "ahmed.said@jax.org",
            github: "",
            contribution: ["author"],
            orcid: ""
        ],
        [
            name: "Martine Seignon",
            affiliation: "The Jackson Laboratory",
            email: "martine.seignon@jax.org",
            github: "",
            contribution: ["author"],
            orcid: ""
        ],
        [
            name: "Greg Perry",
            affiliation: "The Jackson Laboratory",
            email: "greg.perry@jax.org",
            github: "",
            contribution: ["author"],
            orcid: ""
        ]
    ]
    homePage      = "https://github.com/TheJacksonLaboratory"
    mainScript    = "main.nf"
    version       = "0.1.0"
}

// --- Timeline / report / trace ---
timeline {
    enabled = true
    file    = "${params.tracedir}/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.tracedir}/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.tracedir}/trace.txt"
    overwrite = true
}
