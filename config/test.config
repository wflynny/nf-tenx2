params {
    config_profile_description = 'Stub test profile'
    config_profile_contact     = 'nf-tenx2 developers'

    // Use test fixtures
    pubdir = "${launchDir}/test/results"
}

process {
    cpus   = 1
    memory = 512.MB
    time   = 10.min
    executor = 'local'

    // Override all labels to stay within local resource limits
    withLabel: 'process_single' {
        cpus   = 1
        memory = 512.MB
    }
    withLabel: 'process_low' {
        cpus   = 1
        memory = 1.GB
    }
    withLabel: 'process_medium' {
        cpus   = 1
        memory = 1.GB
    }
    withLabel: 'process_high' {
        cpus   = 1
        memory = 2.GB
    }
    withLabel: 'process_long' {
        time = 10.min
    }
    withLabel: 'process_high_memory' {
        memory = 2.GB
    }
}

// No containers in test mode — stubs don't need them
singularity.enabled = false
docker.enabled      = false
