profiles {
    elion2  { includeConfig "config/elion2.config" }
    sumner2 { includeConfig "config/elion2.config" }
    testing { includeConfig "config/test.config" }
}

apptainer.registry    = "quay.io"
docker.registry       = "quay.io"
podman.registry       = "quay.io"
singularity.registry  = "quay.io"
charliecloud.registry = "quay.io"

process.shell = """
bash 
set -euCo pipefail
"""

nextflow.enable.configProcessNamesValidation = false

params {
    inputJsonFiles = null // --input-json-files = inputJsonFiles
    inputDir = null // --input-dir = inputDir
    pipeline = null

    version = "0.0.1"
    
}

