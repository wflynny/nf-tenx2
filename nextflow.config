apptainer.registry    = "quay.io"
docker.registry       = "quay.io"
podman.registry       = "quay.io"
singularity.registry  = "quay.io"
charliecloud.registry = "quay.io"

process.shell = [
    "bash",
    "-C",
    "-e",
    "-u",
    "-o",
    "pipefail"
]

params {
    // --- Input ---
    inputJsonFiles = null   // --input-json-files file1.json file2.json ...
    inputDir       = null   // --input-dir path/to/json/files/
    pipeline       = null   // gex | atac | multiome | visium | xenium

    // --- Output ---
    // --pubdir is the legacy override knob. The canonical setting is `outputDir`
    // (Nextflow native, also overridable via -output-dir). The block below maps
    // params.pubdir -> outputDir for back-compat.
    pubdir   = null
    tracedir = "${launchDir}/pipeline_info"

    // --- Pipeline metadata ---
    version = "0.1.0"
}

// Resolve top-level output directory. Precedence:
//   -output-dir <dir>   (Nextflow CLI; sets outputDir directly, wins over the line below)
//   --pubdir <dir>      (legacy param override)
//   ${launchDir}/results   (default)
//
// NOTE: prior versions defaulted to ${launchDir}/results_${runName} for per-run
// uniqueness. The strict v2 config parser doesn't expose `workflow` at top-level,
// so use -output-dir or --pubdir to set a per-run directory.
outputDir = params.pubdir ?: "${launchDir}/results"

// --- Default resources ---
// Profiles (elion2, sumner2) override these with label-based scaling.
process {
    cpus   = 1
    memory = 6.GB
    time   = 4.h

    withLabel: 'process_single' {
        cpus   = 1
        memory = 6.GB
        time   = 4.h
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 12.GB
        time   = 4.h
    }
    withLabel: 'process_medium' {
        cpus   = 6
        memory = 36.GB
        time   = 8.h
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = 128.GB
        time   = 16.h
    }
    withLabel: 'process_long' {
        time   = 20.h
    }
    withLabel: 'process_high_memory' {
        memory = 200.GB
    }

    // exec: processes can't run on batch executors
    withName: 'CAPTURE_WORKFLOW' {
        executor = 'local'
    }
}

manifest {
    name             = "nf-tenx2"
    nextflowVersion  = ">=26.04.0"
    contributors     = [
        [
            name: "Bill Flynn",
            affiliation: "The Jackson Laboratory",
            email: "bill.flynn@jax.org",
            github: "wflynny",
            contribution: ["author"],
            orcid: "0000-0001-6533-0340"
        ],
        [
            name: "Ahmed Said",
            affiliation: "The Jackson Laboratory",
            email: "ahmed.said@jax.org",
            github: "demhadais",
            contribution: ["author"],
            orcid: ""
        ],
        [
            name: "Martine Seignon",
            affiliation: "The Jackson Laboratory",
            email: "martine.seignon@jax.org",
            github: "mjseignon",
            contribution: ["author"],
            orcid: ""
        ],
        [
            name: "Greg Perry",
            affiliation: "The Jackson Laboratory",
            email: "greg.perry@jax.org",
            github: "mounttaineer",
            contribution: ["author"],
            orcid: ""
        ]
    ]
    homePage      = "https://github.com/TheJacksonLaboratory"
    mainScript    = "main.nf"
    version       = "0.1.0"
}

// --- Timeline / report / trace ---
timeline {
    enabled = true
    file    = "${params.tracedir}/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.tracedir}/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.tracedir}/trace.txt"
    overwrite = true
}

// --- Profiles (must be last so overrides take precedence) ---
profiles {
    elion2  { includeConfig "config/elion2.config" }
    sumner2 { includeConfig "config/sumner2.config" }
    testing { includeConfig "config/test.config" }
}
